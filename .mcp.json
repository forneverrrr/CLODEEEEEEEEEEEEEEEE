{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@latest",
        "--proxy-server=http://127.0.0.1:33769",
        "--ignore-https-errors"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "/root/.ccr/ca-bundle.crt"
      }
    }
  }
}
